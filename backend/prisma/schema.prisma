datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SaleStatus {
  PAID
  PARTIAL
  UNPAID
  VOIDED
}

enum CashEntryType {
  IN
  OUT
}

enum CashSource {
  SALE
  CUSTOMER_PAYMENT
  LABOUR
  EXPENSE
  MANUAL
}

enum SalaryType {
  MONTHLY
  DAILY
  PER_TASK
}

enum PaymentType {
  SALARY
  ADVANCE
}

model Farm {
  id              String            @id @default(cuid())
  name            String
  openingEggStock Int               @default(0)
  openingCash     Decimal           @default(0) @db.Decimal(12, 2)
  petiSize        Int               @default(210)
  isSetupComplete Boolean           @default(false)
  isDemo          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  productions     EggProduction[]
  customers       Customer[]
  sales           Sale[]
  customerPayments CustomerPayment[]
  cashEntries     CashEntry[]
  labourers       Labourer[]
  labourPayments  LabourPayment[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]

  @@index([isDemo])
}

model EggProduction {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id])
  date          DateTime @db.Date
  eggsProduced  Int
  brokenEggs    Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([farmId, date])
  @@index([farmId, date])
}

model Customer {
  id        String            @id @default(cuid())
  farmId    String
  farm      Farm              @relation(fields: [farmId], references: [id])
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sales     Sale[]
  payments  CustomerPayment[]

  @@index([farmId, isActive])
}

model Sale {
  id             String      @id @default(cuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id])
  date           DateTime    @db.Date
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  eggsQty        Int
  pricePerEgg    Decimal     @db.Decimal(10, 4)
  totalAmount    Decimal     @db.Decimal(12, 2)
  amountReceived Decimal     @db.Decimal(12, 2)
  amountDue      Decimal     @db.Decimal(12, 2)
  status         SaleStatus  @default(UNPAID)
  notes          String?
  voidedAt       DateTime?
  voidReason     String?
  cashEntryId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([farmId, date])
  @@index([customerId])
}

model CustomerPayment {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  isAdvance   Boolean  @default(false)
  notes       String?
  cashEntryId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmId, customerId])
  @@index([farmId, date])
}

model CashEntry {
  id          String        @id @default(cuid())
  farmId      String
  farm        Farm          @relation(fields: [farmId], references: [id])
  date        DateTime      @db.Date
  type        CashEntryType
  amount      Decimal       @db.Decimal(12, 2)
  source      CashSource
  referenceId String?
  notes       String?
  isManual    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([farmId, date])
}

model Labourer {
  id           String          @id @default(cuid())
  farmId       String
  farm         Farm            @relation(fields: [farmId], references: [id])
  name         String
  phone        String?
  role         String?
  salaryType   SalaryType
  salaryAmount Decimal         @db.Decimal(12, 2)
  joiningDate  DateTime        @db.Date
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  payments     LabourPayment[]

  @@index([farmId, isActive])
}

model LabourPayment {
  id          String      @id @default(cuid())
  farmId      String
  farm        Farm        @relation(fields: [farmId], references: [id])
  labourerId  String
  labourer    Labourer    @relation(fields: [labourerId], references: [id])
  date        DateTime    @db.Date
  amount      Decimal     @db.Decimal(12, 2)
  paymentType PaymentType
  notes       String?
  cashEntryId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([farmId, labourerId])
  @@index([farmId, date])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([farmId, name])
}

model Expense {
  id          String   @id @default(cuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id])
  date        DateTime @db.Date
  category    String
  description String
  quantity    Decimal? @db.Decimal(10, 2)
  unitCost    Decimal? @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  notes       String?
  cashEntryId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmId, date])
}

model EggMarketPrice {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  zone         String   @default("Luknow (CC)")
  pricePer100  Decimal  @db.Decimal(10, 2)
  pricePerEgg  Decimal  @db.Decimal(10, 4)
  pricePerTray Decimal  @db.Decimal(10, 2)
  pricePerPeti Decimal  @db.Decimal(10, 2)
  source       String   @default("E2NECC")
  rawText      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, zone])
  @@index([date])
  @@index([zone])
}

model BackupLog {
  id            String   @id @default(cuid())
  farmId        String
  driveFileId   String?
  fileName      String
  fileSizeBytes Int      @default(0)
  type          String   @default("MANUAL") // MANUAL | AUTO
  status        String   @default("SUCCESS") // SUCCESS | FAILED
  recordCount   Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([farmId, createdAt])
}

